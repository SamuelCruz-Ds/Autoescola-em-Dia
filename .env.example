# Comece em demo sem instalar banco. Use dados fictícios nesse modo.
DB_MODE=demo
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=autoescola
DB_USER=autoescola
DB_PASSWORD=
# Usada somente pela composição Docker:
MYSQL_ROOT_PASSWORD=

SCHOOL_TIMEZONE=America/Sao_Paulo
# Coordenadas da unidade ou do ponto de saída das aulas práticas.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_HEAVY_MM=10
WEATHER_API_KEY=

# Ative somente depois de configurar a conta de SMS e coletar autorização.
SMS_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
